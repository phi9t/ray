# Copy to .env (same directory) and edit as needed.

ZEPHYR_IMAGE=ghcr.io/phi9t/sygaldry/zephyr:sglang-miles-dev
CONTAINER_NAME=zephyr-ray

# Workspace mounted at /workspace/ray in container.
# Default in launcher is repo root if unset.
WORKSPACE_DIR=/mnt/data_infra/workspace/ray
# Set this per host user UID; value below is an example.
CONTAINER_HOME_HOST=/mnt/data_infra/zephyr_container_infra/shared/homes/ray-1000
CONTAINER_HOME_INNER=/home/ray

# Shared caches/mounts.
SHARED_BAZEL_CACHE_DIR=/mnt/data_infra/zephyr_container_infra/shared/bazel_cache
SHARED_BAZELISK_CACHE_DIR=/mnt/data_infra/zephyr_container_infra/shared/bazelisk_cache
SHARED_UV_CACHE_DIR=/mnt/data_infra/zephyr_container_infra/shared/uv_cache
SHARED_HF_CACHE_DIR=/mnt/data_infra/zephyr_container_infra/shared/hf_cache
SHARED_HF_MODELS_DIR=/mnt/data_infra/zephyr_container_infra/shared/hf_cache/hub

# Runtime/cache behavior in container.
BAZEL_OUTPUT_ROOT=/mnt/shared/bazel_cache/ray-sglang-compose
SYGALDRY_PROJECT_ID=ray-compose
SHM_SIZE=16gb

# GPU exposure.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Published ports.
RAY_DASHBOARD_PORT=8265
RAY_CLIENT_PORT=10001
RAY_GCS_PORT=6379
